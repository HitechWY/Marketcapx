# Template for core/.env.testing (the real file is gitignored).
# Copy to core/.env.testing and fill in local values. Used by `php artisan test`
# / phpunit when APP_ENV=testing. Contains NO real secrets.
#
# Generate a throwaway key (do NOT reuse the production APP_KEY):
#   php -r "echo 'base64:'.base64_encode(random_bytes(32));"

APP_NAME=MarketCapX
APP_ENV=testing
APP_KEY=base64:GENERATE_A_THROWAWAY_KEY
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Point ONLY at a disposable local test database. NEVER paytabz_DB / production.
# Seed it from the schema in the SQL dump (see core/tests/README.md).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketcapx_test
DB_USERNAME=your_local_db_user
DB_PASSWORD=your_local_db_password

SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=array
